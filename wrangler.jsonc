// AgentLens — flagship site, deploys to the existing `createjob` Worker.
// Root config so that Cloudflare Workers Builds' default `npx wrangler deploy` works.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "createjob",
  "main": "sites/agentlens/src/index.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "sites/agentlens/public",
    "binding": "ASSETS"
  },
  // Custom domains on the user's zone. The worker routes by hostname:
  // lens.* -> AgentLens (+ /builder/), agentfront.* -> /store.
  // No llmstxt.* subdomain: a parallel session already runs an llms.txt
  // builder on this zone — ours stays at lens.<domain>/builder/ to avoid
  // duplicate sites on the same domain.
  "routes": [
    { "pattern": "lens.agiscorecard.com", "custom_domain": true },
    { "pattern": "agentfront.agiscorecard.com", "custom_domain": true }
  ],
  "kv_namespaces": [
    {
      "binding": "SIGNUPS",
      "id": "ad034fbd62384eb3abd7b612fc33e268"
    }
  ],
  "observability": {
    "enabled": true
  }
}
