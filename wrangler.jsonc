// AgentLens — flagship site, deploys to the existing `createjob` Worker.
// Root config so that Cloudflare Workers Builds' default `npx wrangler deploy` works.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "createjob",
  "main": "sites/agentlens/src/index.js",
  "compatibility_date": "2026-07-01",
  // In Workers Builds this also deploys llmstxt-builder and agentfront,
  // so one push ships all three sites. No-op locally.
  "build": {
    "command": "node scripts/deploy-siblings.mjs"
  },
  "assets": {
    "directory": "sites/agentlens/public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SIGNUPS",
      "id": "ad034fbd62384eb3abd7b612fc33e268"
    }
  ],
  "observability": {
    "enabled": true
  }
}
